<UserControl x:Class="PwManager.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:PwManager.App.Controls"
             xmlns:s="clr-namespace:PwManager.App.Services"
             xmlns:v="clr-namespace:PwManager.App.Views"
             xmlns:vm="clr-namespace:PwManager.Presentation.ViewModels;assembly=PwManager.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:UnlockViewModel}">
    <Grid>
        <!-- 表示言語の切り替え（右上） -->
        <v:LanguageToggle DataContext="{Binding Language}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0"/>

        <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
            <!-- ロゴ風の見出し -->
            <TextBlock Text="SECRYPT" FontFamily="{StaticResource NumFont}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentGradient}"/>
            <!-- 版の表記（1.00A 形式）は解錠画面にだけ出す -->
            <TextBlock Text="{x:Static s:AppVersion.Label}" FontFamily="{StaticResource NumFont}" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
            <TextBlock Text="{c:T Ja='ロックされています', En='Locked'}" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,2,0,18"/>

            <Border Style="{StaticResource Card}" Padding="22,10,22,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <RadioButton Content="{c:T Ja='PIN（この PC）', En='PIN (this PC)'}" Style="{StaticResource TabRadio}" GroupName="Method"
                                     IsChecked="{Binding IsPinSelected}" IsEnabled="{Binding PinAvailable}"/>
                        <RadioButton Content="{c:T Ja='鍵ファイル', En='Key file'}" Style="{StaticResource TabRadio}" GroupName="Method"
                                     IsChecked="{Binding IsKeyfileSelected}" IsEnabled="{Binding KeyfileAvailable}"/>
                        <RadioButton Content="{c:T Ja='復旧コード', En='Recovery code'}" Style="{StaticResource TabRadio}" GroupName="Method"
                                     IsChecked="{Binding IsRecoverySelected}"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}"/>

                    <!-- PIN -->
                    <StackPanel Visibility="{Binding IsPinSelected, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="PIN" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox c:Secret.Input="{Binding Pin}" FontSize="16"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{c:T Ja='TPM が PIN の失敗回数を数えます（31 回でロック、10 分ごとに 1 回減少）。', En='The TPM counts failed PIN attempts (locks at 31; one is forgiven every 10 minutes).'}"/>
                    </StackPanel>

                    <!-- 鍵ファイル -->
                    <StackPanel Visibility="{Binding IsKeyfileSelected, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{c:T Ja='鍵ファイル', En='Key file'}" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{c:T Ja='選ぶ', En='Browse'}" Command="{Binding ChooseKeyfileCommand}" Margin="8,0,0,2"/>
                            <TextBox Text="{Binding KeyfilePath, Mode=OneWay}" IsReadOnly="True"/>
                        </DockPanel>
                        <Button Content="{c:T Ja='印刷した QR のテキストを入力する', En='Enter the text of the printed QR code'}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Padding="8,3" FontSize="12" Command="{Binding EnterKeyfileTextCommand}"/>
                        <TextBlock Text="{c:T Ja='パスワード', En='Password'}" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox c:Secret.Input="{Binding KeyfilePassword}" FontSize="16"/>
                    </StackPanel>

                    <!-- 復旧コード -->
                    <StackPanel Visibility="{Binding IsRecoverySelected, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{c:T Ja='復旧コード（36 文字。区切りは任意）', En='Recovery code (36 characters; separators optional)'}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RecoveryText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" FontSize="16" CharacterCasing="Upper"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{c:T Ja='解錠後、「鍵と設定」で新しい鍵ファイルや TPM を登録し直すことをおすすめします。', En='After unlocking, we recommend registering a new key file or the TPM again in Keys and settings.'}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource WarnText}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Content="{c:T Ja='解錠する', En='Unlock'}" Style="{StaticResource PrimaryButton}" IsDefault="True"
                            HorizontalAlignment="Stretch" Margin="0,18,0,0" Command="{Binding UnlockCommand}" IsEnabled="{Binding CanUnlock}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding VaultPath}" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
