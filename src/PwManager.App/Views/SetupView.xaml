<UserControl x:Class="PwManager.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:PwManager.App.Controls"
             xmlns:v="clr-namespace:PwManager.App.Views"
             xmlns:vm="clr-namespace:PwManager.Presentation.ViewModels;assembly=PwManager.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             Loaded="View_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="600" Margin="0,28,0,28" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="28,22">
            <StackPanel>
                <DockPanel>
                    <!-- 表示言語の切り替えは最初の手順でだけ出す（途中で作り直すと入力内容が消えるため） -->
                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" Visibility="{Binding IsTpmStep, Converter={StaticResource BoolToVisible}}">
                        <v:LanguageToggle DataContext="{Binding Language}"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="INITIAL SETUP" Style="{StaticResource StepLabel}"/>
                        <TextBlock Text="{Binding StepText}" FontFamily="{StaticResource NumFont}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="3" Value="{Binding StepNumber, Mode=OneWay}" Margin="0,8,0,16"/>

                <!-- ===== STEP 1: TPM + PIN ===== -->
                <StackPanel Visibility="{Binding IsTpmStep, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{c:T Ja='このPCで開くための PIN', En='PIN for opening on this PC'}" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="{c:T Ja='PC内蔵のセキュリティチップ（TPM）に鍵を封印します。普段はこの PIN だけで開けます。PIN の総当たりは TPM が回数制限するため、短めでも安全です。', En='The key is sealed in the security chip built into this PC (TPM). Day to day, this PIN alone opens the vault. The TPM limits the number of PIN attempts, so a fairly short PIN is still safe.'}"/>
                    <Border Style="{StaticResource Callout}">
                        <TextBlock Text="{Binding TpmStatusText}" Style="{StaticResource Body}"/>
                    </Border>
                    <TextBlock Text="{c:T Ja='PIN（6 文字以上）', En='PIN (6 or more characters)'}" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox c:Secret.Input="{Binding Pin}" IsEnabled="{Binding TpmAvailable}"/>
                    <TextBlock Text="{c:T Ja='PIN（確認）', En='PIN (confirm)'}" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox c:Secret.Input="{Binding PinConfirm}" IsEnabled="{Binding TpmAvailable}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{c:T Ja='Windows のサインイン PIN とは別のものにしてください。', En='Use a PIN different from your Windows sign-in PIN.'}"/>
                </StackPanel>

                <!-- ===== STEP 2: キーファイル + パスワード ===== -->
                <StackPanel Visibility="{Binding IsKeyfileStep, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{c:T Ja='USB メモリの鍵ファイルとパスワード', En='Key file on a USB drive and a password'}" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="{c:T Ja='PC の故障・買い替え・TPM が使えないときの開け方です。鍵ファイル（USB メモリ）とパスワードの両方がそろったときだけ開けます。', En='This is how you open the vault when the PC breaks, is replaced, or the TPM cannot be used. It opens only when you have both the key file (USB drive) and the password.'}"/>
                    <TextBlock Text="{c:T Ja='パスワード（10 文字以上）', En='Password (10 or more characters)'}" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox c:Secret.Input="{Binding KeyfilePassword}" IsEnabled="{Binding KeyfileCreated, Converter={StaticResource InverseBool}}"/>
                    <TextBlock Text="{c:T Ja='パスワード（確認）', En='Password (confirm)'}" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox c:Secret.Input="{Binding KeyfilePasswordConfirm}" IsEnabled="{Binding KeyfileCreated, Converter={StaticResource InverseBool}}"/>
                    <TextBlock Text="{c:T Ja='鍵ファイルの保存先（USB メモリを推奨）', En='Where to save the key file (a USB drive is recommended)'}" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{c:T Ja='保存先を選ぶ', En='Choose location'}" Command="{Binding ChooseKeyfileCommand}" Margin="8,0,0,2"
                                IsEnabled="{Binding KeyfileCreated, Converter={StaticResource InverseBool}}"/>
                        <TextBox Text="{Binding KeyfilePath, Mode=OneWay}" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock Text="{Binding KeyfileRiskText}" Style="{StaticResource WarnText}"
                               Visibility="{Binding KeyfileRiskText, Converter={StaticResource NullToCollapsed}}"/>

                    <Border Style="{StaticResource Callout}" Visibility="{Binding KeyfileCreated, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding KeyfileDoneText}" Style="{StaticResource Body}" Foreground="{StaticResource Green}"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,8"
                                       Text="{c:T Ja='予備として、鍵ファイルを QR コードで印刷しておけます。USB メモリを失くしても、この紙とパスワードで開けます。紙に印刷できるプリンターを選んでください（PDF などのファイルに保存すると、鍵ファイルのコピーが PC に残ります）。', En='As a backup, you can print the key file as a QR code. Even if you lose the USB drive, this paper and the password open the vault. Choose a printer that prints on paper (saving to a file such as PDF leaves a copy of the key file on the PC).'}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{c:T Ja='QR コードを印刷', En='Print QR code'}" Style="{StaticResource AccentButton}" Command="{Binding PrintQrCommand}"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding KeyfileStored}" Margin="0,6,0,0"
                                      Content="{c:T Ja='鍵ファイルを保存した（QR の印刷は後からでもできます）', En='I have saved the key file (you can print the QR code later)'}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== STEP 3: 復旧コード ===== -->
                <StackPanel Visibility="{Binding IsRecoveryStep, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{c:T Ja='復旧コード（紙に書き写す）', En='Recovery code (write it down on paper)'}" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Body}"
                               Text="{c:T Ja='PC・USB メモリ・パスワードをすべて失ったときの最後の手段です。紙に書き写し、PC や USB メモリとは別の場所に保管してください。画面の写真やスクリーンショットは撮らないでください。', En='This is the last resort if you lose the PC, the USB drive and the password. Write it down on paper and keep it somewhere separate from the PC and the USB drive. Do not take photos or screenshots of the screen.'}"/>
                    <Border Style="{StaticResource Card}" Background="{StaticResource Panel}" Margin="0,14,0,0"
                            Visibility="{Binding HideCode, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Text="{Binding RecoveryCodeText}" FontFamily="{StaticResource CodeFont}" FontSize="24" Foreground="{StaticResource Accent}"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="38"/>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="{c:T Ja='0（ゼロ）と O、1 と I / L は同じ文字として扱われます。', En='0 (zero) and O, and 1 and I / L, are treated as the same character.'}"/>

                    <TextBlock Text="{c:T Ja='書き写した内容の確認', En='Check what you wrote down'}" Style="{StaticResource FieldLabel}" Margin="0,16,0,3"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding VerifyALabel}" Style="{StaticResource Hint}"/>
                            <TextBox Text="{Binding VerifyA, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" FontSize="16" CharacterCasing="Upper" MaxLength="4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding VerifyBLabel}" Style="{StaticResource Hint}"/>
                            <TextBox Text="{Binding VerifyB, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" FontSize="16" CharacterCasing="Upper" MaxLength="4"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox IsChecked="{Binding HideCode}" Margin="0,10,0,0" Content="{c:T Ja='書き写したので、コードを隠して確認する', En='I have written it down. Hide the code and check'}"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource WarnText}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>

                <DockPanel Margin="0,22,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="{c:T Ja='TPM を使わずに進む', En='Continue without TPM'}" Style="{StaticResource QuietButton}" Command="{Binding SkipTpmCommand}"
                            Visibility="{Binding IsTpmStep, Converter={StaticResource BoolToVisible}}"/>
                    <Button DockPanel.Dock="Right" Content="{Binding NextText}" Style="{StaticResource PrimaryButton}" Margin="0" Command="{Binding NextCommand}"/>
                </DockPanel>
                <TextBlock Text="{Binding VaultPathText}" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
