<Application x:Class="PwManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PwManager.App.Controls"
             xmlns:v="clr-namespace:PwManager.App.Views"
             xmlns:vm="clr-namespace:PwManager.Presentation.ViewModels;assembly=PwManager.Presentation"
             ShutdownMode="OnMainWindowClose">
    <!--
      見た目のテーマ（Themes/Colors.xaml: 色・書体、Themes/Controls.xaml: 部品の見た目）。
      FocusCoach（03章 §3.4.1「近未来の業務支援ツール」）と同じ定義を引き継ぐ。
      - 配色: 深い青緑の背景に、青緑・青のアクセント。強い赤や橙は使わない（注意は柔らかい琥珀）。
      - 文字: 本文は BIZ UDPゴシック、数字・英字ラベルは Bahnschrift。無ければ Yu Gothic UI / Meiryo UI。
      - 色・書体は名前で参照し、画面ごとに直接書かない。
      FocusCoach からの追加: PasswordBox、ListBox、RadioButton（切り替えタブ）、見出し、警告文、コード表示。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
            <c:InverseBoolToVisibilityConverter x:Key="BoolToCollapsed"/>
            <c:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <c:InverseBoolConverter x:Key="InverseBool"/>

            <!-- 画面の切り替え: ShellViewModel.CurrentPage の型で View を選ぶ -->
            <DataTemplate DataType="{x:Type vm:SetupViewModel}">
                <v:SetupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UnlockViewModel}">
                <v:UnlockView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VaultViewModel}">
                <v:VaultView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
