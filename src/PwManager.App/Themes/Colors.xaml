<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      色と書体（FocusCoach 03章 §3.4.1「近未来の業務支援ツール」と同じ定義）。FocusCoach と共有しやすいよう、
      画面の部品（Controls.xaml）と分けている。色・書体は名前で参照し、画面ごとに直接書かない。
    -->

    <!-- 色 -->
    <Color x:Key="BgColor">#0E1A20</Color>
    <Color x:Key="PanelColor">#14252D</Color>
    <Color x:Key="PanelAltColor">#1A3039</Color>
    <Color x:Key="LineColor">#28434E</Color>
    <Color x:Key="TextColor">#DCEBEF</Color>
    <Color x:Key="TextMutedColor">#8EA9B3</Color>
    <Color x:Key="TextDimColor">#5E7C87</Color>
    <Color x:Key="AccentColor">#4FD1C5</Color>
    <Color x:Key="Accent2Color">#6CB4EE</Color>
    <Color x:Key="GreenColor">#8BD3A8</Color>
    <Color x:Key="WarnColor">#E3C27A</Color>
    <Color x:Key="PausedColor">#7D919B</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAlt" Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Paused" Color="{StaticResource PausedColor}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1F4FD1C5"/>
    <SolidColorBrush x:Key="HoverFill" Color="#1A6CB4EE"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#1FE3C27A"/>
    <SolidColorBrush x:Key="Overlay" Color="#CC0E1A20"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- 文字 -->
    <FontFamily x:Key="UiFont">BIZ UDPGothic, Yu Gothic UI, Meiryo UI</FontFamily>
    <FontFamily x:Key="NumFont">Bahnschrift, Segoe UI, Yu Gothic UI</FontFamily>
    <FontFamily x:Key="CodeFont">Bahnschrift SemiCondensed, Consolas, BIZ UDGothic</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>
</ResourceDictionary>
