<Window x:Class="PwManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:PwManager.App.Controls"
        xmlns:vm="clr-namespace:PwManager.Presentation.ViewModels;assembly=PwManager.Presentation"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Secrypt" Width="1000" Height="680" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" StateChanged="Window_StateChanged">
    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}"/>
    </Window.InputBindings>
    <!-- タイトルバーは FocusCoach と同じく WindowChrome の細い帯（ドラッグ移動・スナップは OS 標準のまま） -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="EdgeBorder" BorderThickness="1" BorderBrush="{StaticResource Line}">
        <DockPanel>
            <!-- タイトル帯 -->
            <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Panel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,9,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="SECRYPT" FontFamily="{StaticResource NumFont}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE72E;" ToolTip="{c:T Ja='今すぐロック (Ctrl+L)', En='Lock now (Ctrl+L)'}"
                            AutomationProperties.Name="{c:T Ja='ロック', En='Lock'}" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding LockCommand}"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisible}}"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="{c:T Ja='最小化', En='Minimize'}" AutomationProperties.Name="{c:T Ja='最小化', En='Minimize'}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="{c:T Ja='最大化', En='Maximize'}" AutomationProperties.Name="{c:T Ja='最大化', En='Maximize'}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="{c:T Ja='閉じる（ロックして終了）', En='Close (lock and exit)'}" AutomationProperties.Name="{c:T Ja='閉じる', En='Close'}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource AccentGradient}" Opacity="0.55"/>
            </Grid>

            <Grid>
                <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
                <!-- 処理中（Argon2id・TPM）。画面全体を薄く覆う -->
                <Border Background="{StaticResource Overlay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">
                        <TextBlock Text="PROCESSING" Style="{StaticResource StepLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BusyText}" Margin="0,6,0,12" HorizontalAlignment="Center" Foreground="{StaticResource Text}"/>
                        <ProgressBar IsIndeterminate="True" Style="{StaticResource ThinProgress}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
